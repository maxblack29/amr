%% Homework 2 Question 5
% By: Max Black
% Due: 10/13/26

clear;
clc;
close all;

% workspace definition
x = 0:1:100;
y = 0:1:100;
[X, Y] = meshgrid(x, y);

% intialize known variables and constants
q_start = [10 80];
q_goal = [80 20];
obstacle = [30 50;
    50 50;
    50 70;
    30 70];
center = [40 60];
epsilon = 0.01;
eta = 100000;
d0 = 20;
rho_min = 11;
tol = 0.5; 
dt = 0.1;
vmax = 5;
nstep = 20000;

q = q_start; % initial q 
path = q; % initial path vector

for step = 1:nstep
    
    % attractive force
    F_att = -epsilon * (q-q_goal); 
    
    % repulsive force
    rho = sqrt((q(1)-center(1))^2 + (q(2)-center(2))^2);
    if rho <= d0
        grad_rho = (q-center)/rho;
        rho_eff = max(rho, rho_min);
        F_rep = eta*((1/rho_eff)-1/d0)*(1/rho_eff^2)*grad_rho;
    else
        F_rep = [0 0];
    end

    u = F_att + F_rep;

    speed = sqrt(u(1)^2+u(2)^2);
    if speed > vmax
        u = u * (vmax / speed);
    end

    q = q + u*dt;
    path(end+1, :) = q; % store in path array

    if sqrt((q(1)-q_goal(1))^2 + (q(2)-q_goal(2))^2) < tol 
        break 
    end
end

d_goal = sqrt((q_goal(1)-X).^2 + (q_goal(2)-Y).^2);
d_obs  = sqrt((center(1)-X).^2 + (center(2)-Y).^2);
U_att  = 0.5 * epsilon * d_goal.^2;
U_rep  = 0.5 * eta * (1./max(d_obs, rho_min) - 1/d0).^2;
U_rep(d_obs > d0) = 0;
U_total = U_att + U_rep;

figure;
hold on
contour(X, Y, U_total, 30); % field lines
%fill(obstacle(:,1), obstacle(:,2), 'k'); % the square
plot(path(:,1), path(:,2), 'r'); % trajectory
plot(q_start(1), q_start(2), 'go');
plot(q_goal(1),  q_goal(2),  'bx');
axis([0 100 0 100]); axis equal;
xlabel('X (m)'); 
ylabel('Y (m)');
title('Question 5: Holonomic Robot Trajectory');

%% Animation
figure; 
hold on;
contour(X, Y, U_total, 30);
%fill(obstacle(:,1), obstacle(:,2), 'k');
plot(q_start(1), q_start(2), 'go');
plot(q_goal(1),  q_goal(2),  'bx');
axis([0 100 0 100]); axis equal;
xlabel('X (m)'); ylabel('Y (m)');
title('Question 5: Robot Animation');

robot = plot(path(1,1), path(1,2), 'ro', 'MarkerSize', 10, 'MarkerFaceColor', 'r');
trail = plot(path(1,1), path(1,2), 'r-', 'LineWidth', 1.5);

for i = 1:1:size(path, 1)
    set(robot, 'XData', path(i,1), 'YData', path(i,2));
    set(trail, 'XData', path(1:i,1), 'YData', path(1:i,2));
    drawnow;
end